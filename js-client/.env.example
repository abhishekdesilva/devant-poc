# Copy to .env and fill in the values the customer shares.
# Any value can also be overridden with an environment variable or a --KEY=value flag.

# --- OAuth2 endpoints & client -------------------------------------------------
# Customer has mentioned both of these hosts/paths — confirm which is correct per env:
#   https://api-dev.providentnj.com/token  |  https://api.providentnj.com/oauth2/token
TOKEN_URL=https://api.providentnj.com/oauth2/token
AUTHORIZE_URL=https://api.providentnj.com/oauth2/authorize
CLIENT_ID=
CLIENT_SECRET=
# basic = HTTP Basic header (default) | body = client_id/secret in form body | none = public client (PKCE)
TOKEN_AUTH_METHOD=basic
# e.g. "openid email profile" to also get an id_token
SCOPE=

# --- Authorization code grant --------------------------------------------------
# Must exactly match the callback URL registered on the OAuth application.
# A local http URL lets the client capture the code automatically; otherwise you paste the redirected URL.
REDIRECT_URI=http://localhost:8080/callback
USE_PKCE=true
# Extra query params for /authorize, URL-encoded (e.g. prompt=login)
EXTRA_AUTHORIZE_PARAMS=
OPEN_BROWSER=true
CALLBACK_TIMEOUT_SECONDS=300

# --- JWT verification (optional; decode-only when JWKS_URL is empty) -----------
JWKS_URL=
EXPECTED_ISSUER=
EXPECTED_AUDIENCE=

# --- API invocation (skipped when API_URL is empty) ----------------------------
# Bijira API endpoint — e.g. the API hosted in the Private Data Plane (PDP)
API_URL=
API_METHOD=GET
API_BODY=
API_CONTENT_TYPE=application/json
# JSON object of additional headers
API_EXTRA_HEADERS=
# Header carrying a per-request UUID to search for in Devant logs
CORRELATION_HEADER=X-Correlation-ID
# Optional X-Forwarded-For value (for the XFF test)
FORWARDED_FOR=

# --- Output --------------------------------------------------------------------
# Save the token response (e.g. to feed an access/refresh token into JMeter)
TOKEN_OUTPUT_FILE=
