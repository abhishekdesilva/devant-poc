# Copy to .env and fill in. Keep .env private: it holds credentials.
# Any value can be overridden per run, e.g. node run-comparison.js --DURATION_SECONDS=120

# --- The two integrations (invoke URLs from Devant, ending in /v1.0) -------------
NON_ISOLATED_URL=
ISOLATED_URL=

# --- Token: a Devant Developer Portal application subscribed to BOTH APIs --------
TOKEN_URL=
CLIENT_ID=
CLIENT_SECRET=
# basic | body | none
TOKEN_AUTH_METHOD=basic
SCOPE=
# client_credentials | static
LOAD_GRANT_TYPE=client_credentials
# static only: an access token you already have
ACCESS_TOKEN=

# --- What to run ------------------------------------------------------------------
# Comma-separated <work>:<users>. work = cpu (GET /cpu) or io (GET /io)
SCENARIOS=cpu:1,cpu:10,cpu:25,io:25
# Length of each run, in seconds
DURATION_SECONDS=60
# Per variant, before the first scenario; not included in the results
WARMUP_SECONDS=20
# Pause between runs, in seconds
COOLDOWN_SECONDS=10
# Size of the CPU work: GET /cpu?iterations=
CPU_ITERATIONS=10000000
# Length of the I/O wait: GET /io?ms=
IO_MS=200
REQUEST_TIMEOUT_MS=30000

# --- Output -----------------------------------------------------------------------
OUTPUT_DIR=results
# Optional name added to the results folder, e.g. devant
RUN_LABEL=
